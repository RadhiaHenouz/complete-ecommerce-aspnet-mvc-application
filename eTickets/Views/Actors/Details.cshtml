
@model Actor
@{
    ViewData["Title"] = "Add new actor";
}
<div class="row text">
    <div class="col-md-8 offset-2">
        <p>
            <h1>Details for @Model.FullName</h1>
        </p>
        <div class="row">
            <div class="col-md-8 offset-2">
                <div class="form-group">
                    <input asp-for="ProfilePictureURL" class="form-control" type="hidden" id="ProfilePictureURL" />
                    <span asp-validation-for="ProfilePictureURL" class="text-danger"></span>
                </div>
                @if(Model.ProfilePictureURL!=null)
                {
                     <img src="~/Uploads/6aba51f6c83e62fd1ff83912.webp" width="150px" max-width="150px"  alt="img" />
                }
                else 
                {
                    <div class="form-group">
                        <label>Upload Image:</label>
                        <input type="file" name="postedFile" id="postedFile" class="form-control" readonly />

                    </div>
                }

                  
                    <div class="form-group">
                        <label asp-for="FullName" class="control-label"></label>
                        <input asp-for="FullName" class="form-control" readonly />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Bio" class="control-label"></label>
                        <input asp-for="Bio" class="form-control" readonly />
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <a asp-controller="Actors" asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i>Create</a>
                        <a class="btn btn-outline-success float right" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                        <a class="btn btn-outline-secondary" asp-action="Index"> Show All</a>
                    </div>
               
            </div>
        </div>
    </div>

</div>
@section scripts
{
    <script>
        $(document).ready(function(){
         var output =document.getElementById("profilePicturePreview");
        output.src=$("ProfilePictureURL").val();
        })
       
   
      
    </script>

}
