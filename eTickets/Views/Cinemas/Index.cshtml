@*define model*@
@model IEnumerable<Cinema>
@{
    ViewData["Title"] = "Cinemas";
}
<html>
    <head>
        <title>
            @ViewData["Title"]
        </title>
    </head>
    <body>
        <div class="row">
            <div class="table">
                <table class="table">
                    <thead> 
                       <tr>
                        <th>@Html.DisplayNameFor(Model=>Model.Logo)</th>
                        <th>@Html.DisplayNameFor(Model => Model.Name)</th>
                        <th> @Html.DisplayNameFor(Model => Model.Description)</th>
                        <th> Actions </th>
                       </tr>
                     </thead>
                     <tbody>
                         @foreach(var item in Model)
                         {
                        
                        <tr>
                            <td class="align-middle"><img class="rounded-circle" src="@item.Logo" alt="@item.Name" style="max-width:150px" /></td>
                            <td class="align-middle">@Html.DisplayFor(modelItem => item.Name)</td>
                            <td class="align-middle">@Html.DisplayFor(modelItem => item.Description)</td>
                            <td class="align-middle"><a href="" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i>Edit</a><a href="" class="btn btn-outline-info"><i class="bi bi-eye"></i>Details</a><a href="" class="btn btn-danger"><i class="bi bi-trash text-white"></i>Delete</a></td>
                        </tr>
                        
                         }
                     </tbody>
                   
                </table>
            </div>
        </div>
</body>
