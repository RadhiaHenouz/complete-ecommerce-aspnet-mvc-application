@*define the model*@
@model IEnumerable<Producer>
@{
    ViewData["Title"] = "Producers";
}
<html>
    <head>
        <title>
            @ViewData["Title"]
        </title>
    </head>
    <body>
        <div class="row">
            <div class="table">
                <table class="table">
                    <thead> 
                       <tr>
                        <th>@Html.DisplayNameFor(Model=>Model.ProfilePictureURL) </th>
                        <th>@Html.DisplayNameFor(Model => Model.FullName)</th>
                        <th> @Html.DisplayNameFor(Model => Model.Bio)</th>
                        <th> Actions </th>
                       </tr>
                     </thead>
                     <tbody>
                         @foreach(var item in Model)
                         {
                        
                        <tr>
                            <td class="align-middle"><img class="rounded-circle" src="@item.ProfilePictureURL" alt="@item.FullName" style="max-width:150px" /></td>
                            <td class="align-middle">@Html.DisplayFor(modelItem => item.FullName)</td>
                            <td class="align-middle">@Html.DisplayFor(modelItem => item.Bio)</td>
                            <td class="align-middle">
                                <a class="btn btn-outline-primary" asp-controller="Producers" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i>Edit</a>
                                <a class="btn btn-outline-info" asp-controller="Producers" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye"></i>Details</a>
                                <a class="btn btn-danger" onclick="openDeleteModal(@item.Id)"><i class="bi bi-trash text-white"></i>Delete</a>

                            </td>
                        </tr>
                        
                         }
                     </tbody>
                  
                </table>
            </div>
        </div>
    <div style="position:fixed; right:25px;bottom:25px;" class="text-white">
    <a asp-controller="Producers" asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i>Add New</a>
    </div>
    </body>
</html>
